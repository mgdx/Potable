<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark system theme: the window is the night navy (#0B1838, as in
         PotableTheme's dark scheme) rather than a flash of another colour
         before the first Compose frame. values-night-v31/ repeats this style
         with the splash screen. -->
    <style name="Theme.Potable" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0B1838</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
