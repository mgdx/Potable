<?xml version="1.0" encoding="utf-8"?>
<!--
    Reference strings of Potable, in English (SPEC §11). Read
    docs/translations.md, "For translators", and docs/glossary.md before
    translating.

    - Strings are grouped by screen, in the order the user meets them.
    - A comment above a string gives its context: what each parameter
      (%1$s, %1$d) stands for, and the room available for short labels
      (chips, buttons, titles). Comments are not translated.
    - Parameters that receive data from Hub'Eau (commune and unit names,
      labels, values with their unit) are isolated by the code for
      right-to-left languages: never add RLM, LRM or isolate marks here.
    - Labels published by Hub'Eau (parameters, units, sanitary conclusions,
      limits such as "<=50 mg/L") are data, shown in French in every
      language: they never appear in this file.
-->
<resources>
    <!-- Name of the app, never translated (docs/glossary.md). -->
    <string name="app_name" translatable="false">Potable</string>

    <!-- ===== Shared actions ===== -->

    <!-- Screen reader label of the back arrow of every screen. -->
    <string name="action_back">Back</string>
    <!-- Button under an error message. Short: about 15 characters. -->
    <string name="action_retry">Retry</string>
    <!-- Dismiss button of the confirmation dialogs. Short: about 15 characters. -->
    <string name="action_cancel">Cancel</string>
    <!-- Screen reader label of the cross that empties a search field (communes, parameters). -->
    <string name="action_clear_search">Clear search</string>
    <!-- Screen reader label of the ⋮ menu of the top bar. -->
    <string name="action_more_options">More options</string>
    <!-- Screen reader label of the search icon of the sheet, and button of the empty "My communes" screen. -->
    <string name="action_search_commune">Search for a commune</string>
    <!-- A followed place, read by screen readers and used as notification title. %1$s: commune name; %2$s: distribution unit name, both as published. -->
    <string name="commune_and_unit">%1$s, %2$s</string>

    <!-- ===== Loading and errors, on every screen that loads data from Hub'Eau ===== -->

    <string name="error_network">Can’t reach Hub\'Eau. Check your connection.</string>
    <string name="error_too_slow">Hub\'Eau took too long to answer. Try again later.</string>
    <string name="error_unavailable">Hub\'Eau is unavailable right now.</string>
    <string name="error_unexpected_response">Hub\'Eau sent an unexpected response.</string>
    <string name="error_unexpected">Something went wrong. Try again.</string>
    <!-- Shown under a loading message after a few seconds. -->
    <string name="loading_slow">Hub\'Eau is slow to answer, still waiting…</string>

    <!-- ===== Compliance and quality thresholds, shared by the sheet, the sample detail, the history ===== -->

    <!-- Compliance codes published by Hub'Eau (docs/glossary.md: compliant, derogation, not_assessed). Shown alone under a heading. -->
    <string name="compliance_compliant">Compliant</string>
    <string name="compliance_compliant_under_derogation">Compliant under a derogation</string>
    <string name="compliance_not_compliant">Not compliant</string>
    <string name="compliance_not_assessed">Not assessed</string>
    <string name="compliance_unknown">Unknown</string>
    <!-- Headings of the four compliance codes of a sample. -->
    <string name="sheet_limits_bacteriological">Quality limits, bacteriological</string>
    <string name="sheet_limits_physicochemical">Quality limits, physico-chemical</string>
    <string name="sheet_references_bacteriological">Quality references, bacteriological</string>
    <string name="sheet_references_physicochemical">Quality references, physico-chemical</string>
    <!-- %1$s: the quality limit of a parameter, as published by Hub'Eau, in French ("<=50 mg/L"). Also the chart legend of a limit drawn in the chart range. -->
    <string name="quality_limit">Quality limit: %1$s</string>
    <!-- %1$s: the quality reference of a parameter, as published by Hub'Eau, in French (">=6,5 et <=9 unité pH"). -->
    <string name="quality_reference">Quality reference: %1$s</string>
    <!-- Under a result measured on site by the sampler (Hub'Eau code_lieu_analyse "T"), not in the laboratory. -->
    <string name="result_measured_on_site">Measured on site</string>
    <!-- In place of the value of a result Hub'Eau published without one. -->
    <string name="sample_no_value">No value published</string>
    <!-- Small caption under a sanitary conclusion shown as published, in French. -->
    <string name="sheet_official_wording">Official wording, in French</string>
    <!-- Caption above the parameter labels published by Hub'Eau, in French. -->
    <string name="sample_official_labels">Official labels, in French, as published by Hub\'Eau.</string>

    <!-- ===== First-launch notice (SPEC §14) ===== -->

    <string name="disclaimer_title">Before you start</string>
    <string name="disclaimer_point_source">The results come from the official sanitary control carried out by the regional health agencies (ARS), published by the French Ministry of Health through Hub\'Eau.</string>
    <string name="disclaimer_point_freshness">The data are updated once a month: a result shown here may be several weeks old.</string>
    <string name="disclaimer_point_scope">Tests are made on the distribution unit, not at your own tap: the state of the private pipes in your building is not covered.</string>
    <string name="disclaimer_point_no_advice">Potable gives no health advice. If in doubt, contact your regional health agency (ARS), named on the sheet of each commune, or your water distributor.</string>
    <string name="disclaimer_point_no_score">Potable adds no score, rating or classification of its own: it shows the official conclusions as published.</string>
    <!-- Full-width button of the first page of the notice, that shows the second one. -->
    <string name="disclaimer_next">Next</string>
    <!-- Full-width button that closes the notice. -->
    <string name="disclaimer_accept">I understand</string>
    <!-- Screen reader label of the page dots above the button. %1$d: current page, %2$d: number of pages. -->
    <string name="intro_page_indicator">Page %1$d of %2$d</string>
    <!-- Second page of the first-launch notice: the alerts (SPEC §5 F7). -->
    <string name="intro_alerts_title">Alerts for your communes</string>
    <!-- "Follow" and "My communes" are sheet_follow and follows_title: keep the same words. -->
    <string name="intro_alerts_point_follow">Follow a commune with the Follow button of its sheet: you will find it in My communes.</string>
    <string name="intro_alerts_point_notify">Potable can then check your communes in the background and notify you when a new analysis is published, or only when its conclusion is unfavourable.</string>
    <!-- "Settings" is settings_title: keep the same word. -->
    <string name="intro_alerts_point_off">Alerts are off by default. Turn them on in Settings, from the menu at the top of the screen: Potable will then ask for permission to show notifications.</string>

    <!-- ===== Search for a commune (start screen, SPEC §5 F1) ===== -->

    <!-- Label of the search field. -->
    <string name="search_label">Commune or postal code</string>
    <string name="search_hint">Search for your commune by name or postal code to see the latest tap water test results.</string>
    <string name="search_loading">Loading the list of communes…</string>
    <!-- %1$s: what the user typed. -->
    <string name="search_no_results">No commune matches “%1$s”.</string>
