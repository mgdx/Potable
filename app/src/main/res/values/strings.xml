    <string name="sheet_conclusion_title">Sanitary conclusion of the latest sample</string>
    <string name="sheet_no_conclusion">No sanitary conclusion was published for this sample.</string>
    <!-- Heading of the same card when Hub'Eau published several samples on the latest day (shown verbatim, in French, one after the other). -->
