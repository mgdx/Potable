    <string name="search_published_under">Water data published under the parent commune: %1$s</string>
    <!-- Under a “commune, unit” row of the results: the unit is followed (see sheet_following). Short: about 15 characters. -->
    <string name="search_unit_followed">Followed</string>
    <!-- Heading above the units whose sheet was last opened, shown while nothing is typed. -->
    <string name="search_recent_title">Recent</string>
    <!-- Screen reader label of the button that takes a unit off the recent list. %1$s: commune_and_unit, "commune, unit". -->
    <string name="search_recent_remove">Remove %1$s from recent</string>
    <!-- Button of the search screen that finds the commune of the device position. Short: about 20 characters. Quoted in about_privacy. -->
    <string name="nearby_action">Near me</string>
    <string name="nearby_locating">Finding the commune you are in…</string>
    <!-- Heading above the commune found by "Near me". -->
    <string name="nearby_found_title">Near you</string>
    <string name="nearby_permission_denied">Without location access, Potable can’t find your commune. You can still search for it by name or postal code.</string>
    <string name="nearby_disabled">Location is turned off on this device. Turn it on, or search for your commune by name or postal code.</string>
    <string name="nearby_unavailable">Your position couldn’t be found in time. Try again, or search for your commune by name or postal code.</string>
    <string name="nearby_no_commune">No French commune was found near you. Search for yours by name or postal code.</string>

    <!-- ===== Choice of the distribution unit (SPEC §5 F2) ===== -->

    <string name="udi_loading">Looking for the distribution units of this commune…</string>
    <string name="udi_none">No distribution unit is listed for this commune.</string>
    <string name="udi_choice_title">Choose your distribution unit</string>
    <!-- Explains the notion, never assumed known (SPEC §9; docs/glossary.md, udi). -->
    <string name="udi_explanation">A distribution unit is the part of the water network that delivers water of the same quality. Several serve this commune: pick the one for your area.</string>
    <!-- Under the unit chosen earlier, in the list of units. -->
    <string name="udi_current_choice">Your current choice</string>
    <!-- Label of the filter field above a long list of units (more than 8). -->
    <string name="udi_search_label">Search a distribution unit</string>
    <!-- %1$s: what the user typed in the filter field. -->
    <string name="udi_no_match">No distribution unit matches “%1$s”.</string>

