        <item quantity="one">%d sample not compliant with the quality references only</item>
        <item quantity="other">%d samples not compliant with the quality references only</item>
    </plurals>
    <!-- Line of the box. %d: samples published compliant everywhere, whose conclusion still mentions a restriction or a consumption advised against. -->
