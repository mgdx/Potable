    <string name="sheet_sample_number">Sample %1$d of %2$d</string>
    <!-- Under the card of several samples. -->
    <string name="sheet_details_of_latest">The key parameters and compliance below are those of the most recent sample.</string>
    <!-- Heading of a small box on the sheet, shown only when samples of the last 12 months have an unfavourable published result (non-compliance, consumption advised against or forbidden). It sits just above the sample history button. -->
    <string name="sheet_recent_unfavourable_title">Over the last 12 months</string>
    <!-- Line of the box. %d: samples of the last 12 months published non-compliant with a quality limit (bacteriological or physico-chemical). -->
    <plurals name="sheet_recent_limits">
        <item quantity="one">%d sample not compliant with the quality limits</item>
        <item quantity="other">%d samples not compliant with the quality limits</item>
    </plurals>
    <!-- Line of the box. %d: samples published non-compliant with a quality reference, and with no quality limit. -->
