<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later (docs/decisions.md). android:allowBackup="false"
     turns off the cloud backup, but not the transfer to a new device, which
     only these rules can refuse: nothing of the application's storage leaves
     the device, neither way. Below Android 12, allowBackup="false" covers
     both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
