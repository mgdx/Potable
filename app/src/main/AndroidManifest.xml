<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions (SPEC §10). INTERNET is granted at install time; coarse
         location is optional, asked for only when "near me" is tapped;
         notifications (Android 13+) only when an alert is switched on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WorkManager declares a foreground service for workers that ask for
         one; the alert check never does (SPEC §5 F7: no foreground service).
         WAKE_LOCK, ACCESS_NETWORK_STATE and RECEIVE_BOOT_COMPLETED stay:
         WorkManager needs them to run the periodic check with its network
         constraint and to plan it again after a restart. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- The application works without any location hardware. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- localeConfig lists the languages of the per-app language settings
         (Android 13+, SPEC §11.1); older versions ignore it and follow the
         system language, hence tools:targetApi.
         No backup, to the cloud or to a new device (docs/decisions.md): the
         followed communes are retyped in a minute, and the rest is a cache of
         public data. allowBackup="false" is enough up to Android 11; from 12
         on it no longer stops a device-to-device transfer, which the
         extraction rules refuse. fullBackupContent="false" says the same to
         Android 6 to 11, and to lint.
         enableOnBackInvokedCallback opts in to the predictive back gesture
         (Android 13+): the only BackHandler, on the first-launch notice,
         is a Compose one, which follows it. -->
    <application
        android:name=".PotableApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Potable"
        tools:targetApi="tiramisu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Potable"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>

</manifest>
